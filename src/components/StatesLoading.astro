---
/**
 * StatesLoading — Shows loading skeleton and form validation states.
 */
import DemoBlock from './ui/DemoBlock.astro';
---

<div class="space-y-8">
  <!-- Skeleton Loading -->
  <DemoBlock label="Skeleton Loading">
    <div class="flex items-start gap-4">
      <div class="h-12 w-12 rounded-none bg-zinc-200"></div>
      <div class="flex flex-col gap-3">
        <div
          class="h-4 w-48 rounded-none"
          style="background: linear-gradient(90deg, #E4E4E7 25%, #F4F4F5 50%, #E4E4E7 75%); background-size: 200% 100%; animation: shimmer 1.5s infinite;"
        ></div>
        <div
          class="h-4 w-64 rounded-none"
          style="background: linear-gradient(90deg, #E4E4E7 25%, #F4F4F5 50%, #E4E4E7 75%); background-size: 200% 100%; animation: shimmer 1.5s infinite;"
        ></div>
      </div>
    </div>
  </DemoBlock>

  <!-- Form Validation -->
  <DemoBlock label="Form Validation">
    <div class="max-w-xs space-y-2">
      <label class="block font-heading font-semibold" style="color: #dc2626;">
        Password
      </label>
      <input
        type="text"
        value="123"
        readonly
        class="w-full border-2 px-3 py-2 font-body text-zinc-900"
        style="border-color: #ef4444;"
      />
      <p class="flex items-center gap-1 text-sm" style="color: #dc2626;">
        <span class="font-heading">ⓘ</span> Password is too short
      </p>
    </div>
  </DemoBlock>
</div>
