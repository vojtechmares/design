---
interface Props {
  name: string;
  hex: string;
  rgb?: string;
  tailwind?: string;
  usage?: string;
  cmyk?: string;
  oklch?: string;
}

const { name, hex, rgb, tailwind, usage, cmyk, oklch } = Astro.props;

const meta = [
  { label: 'HEX', value: hex },
  { label: 'RGB', value: rgb },
  { label: 'TW', value: tailwind },
  { label: 'CMYK', value: cmyk },
  { label: 'OKLCH', value: oklch },
].filter((m) => m.value);
---

<div>
  <div class="h-20 w-full" style={`background-color: ${hex};`}></div>
  <div class="mt-3">
    <h4>{name}</h4>
    <dl class="mt-1 space-y-0.5 text-xs text-neutral-500">
      {meta.map((m) => (
        <div class="flex gap-2">
          <dt class="font-bold uppercase">{m.label}</dt>
          <dd>{m.value}</dd>
        </div>
      ))}
    </dl>
    {usage && <p class="mt-2 text-xs text-neutral-500">{usage}</p>}
  </div>
</div>
