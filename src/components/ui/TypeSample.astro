---
interface Props {
  element: string;
  font: string;
  weight: string;
  size: string;
  lineHeight: string;
  usage: string;
}

const { element, font, weight, size, lineHeight, usage } = Astro.props;

const Element = element as any;

const fontFamily: Record<string, string> = {
  'IBM Plex Sans': 'font-display',
  'Inter': 'font-heading',
  'JetBrains Mono': 'font-mono',
};

const fontClass = fontFamily[font] ?? 'font-heading';
---

<div>
  <Element
    class={fontClass}
    style={`font-size: ${size}; font-weight: ${weight}; line-height: ${lineHeight};`}
  >
    The quick brown fox jumps over the lazy dog
  </Element>
  <div class="mt-2 flex flex-wrap gap-4 text-xs text-zinc-500">
    <code class="font-mono">{font}</code>
    <code class="font-mono">{size}</code>
    <code class="font-mono">{weight}</code>
    <code class="font-mono">{lineHeight}</code>
  </div>
  <p class="mt-1 text-xs text-zinc-500">{usage}</p>
</div>
