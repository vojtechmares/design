---
interface Props {
  id?: string;
  ariaLabel?: string;
  variant?: 'default' | 'surface' | 'inverse' | 'accent';
  class?: string;
}

const { id, ariaLabel, variant = 'default', class: className } = Astro.props;

const variantStyles: Record<string, string> = {
  default: 'bg-white',
  surface: 'bg-zinc-50',
  inverse: 'bg-zinc-900 text-zinc-100',
  accent: 'bg-orange-500 text-black',
};
---

<section
  id={id}
  aria-label={ariaLabel}
  class:list={[variantStyles[variant], 'py-16 px-8', className]}
>
  <slot />
</section>
