---
interface Props {
  label?: string;
  variant?: 'light' | 'dark' | 'muted';
}

const { label, variant = 'light' } = Astro.props;

const variantClasses: Record<string, string> = {
  light: 'bg-white border-zinc-200',
  dark: 'bg-zinc-900 border-zinc-700',
  muted: 'bg-zinc-100 border-zinc-200',
};
---

<div>
  {label && (
    <span class="mb-2 block font-heading text-xs font-semibold uppercase tracking-wider text-zinc-500">
      {label}
    </span>
  )}
  <div
    class:list={[
      'border p-6',
      variantClasses[variant],
    ]}
  >
    <slot />
  </div>
</div>
