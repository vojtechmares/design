---
/**
 * FormsInputs — Form input demos and assembled form examples.
 */
import Section from './ui/Section.astro';
import DemoBlock from './ui/DemoBlock.astro';
---

<Section id="forms-inputs" title="Forms & Inputs" subtitle="Input fields, form controls, and validation guidelines.">
<div class="space-y-8">

  <p class="text-sm text-zinc-600">
    All form elements use sharp corners (0px border-radius) consistent with the design system. Inputs use a 1px zinc border with a subtle focus transition.
  </p>

  <!-- Individual input demos — 2-column grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

    <!-- Text Input -->
    <DemoBlock label="Text Input">
      <div class="max-w-sm">
        <label class="block font-heading text-sm font-semibold text-zinc-900 mb-1.5">Full Name</label>
        <input
          type="text"
          placeholder="Jane Doe"
          class="border border-zinc-300 bg-white px-4 py-2.5 text-sm text-zinc-700 w-full focus:outline-none focus:border-zinc-500 transition-colors"
        />
      </div>
    </DemoBlock>

    <!-- Email Input -->
    <DemoBlock label="Email Input">
      <div class="max-w-sm">
        <label class="block font-heading text-sm font-semibold text-zinc-900 mb-1.5">Email Address</label>
        <input
          type="email"
          placeholder="jane@example.com"
          class="border border-zinc-300 bg-white px-4 py-2.5 text-sm text-zinc-700 w-full focus:outline-none focus:border-zinc-500 transition-colors"
        />
      </div>
    </DemoBlock>

    <!-- Phone Number -->
    <DemoBlock label="Phone Number">
      <div class="max-w-sm">
        <label class="block font-heading text-sm font-semibold text-zinc-900 mb-1.5">Phone Number</label>
        <input
          type="tel"
          placeholder="+1 (555) 000-0000"
          class="border border-zinc-300 bg-white px-4 py-2.5 text-sm text-zinc-700 w-full focus:outline-none focus:border-zinc-500 transition-colors"
        />
      </div>
    </DemoBlock>

    <!-- Checkbox -->
    <DemoBlock label="Checkbox">
      <div class="space-y-3">
        <label class="flex items-center gap-3 cursor-pointer">
          <input
            type="checkbox"
            checked
            class="form-checkbox appearance-none w-5 h-5 border border-zinc-300 bg-white checked:bg-orange-500 checked:border-orange-500 transition-colors cursor-pointer shrink-0"
          />
          <span class="text-sm text-zinc-700">I agree to the Terms of Service</span>
        </label>
        <label class="flex items-center gap-3 cursor-pointer">
          <input
            type="checkbox"
            class="form-checkbox appearance-none w-5 h-5 border border-zinc-300 bg-white checked:bg-orange-500 checked:border-orange-500 transition-colors cursor-pointer shrink-0"
          />
          <span class="text-sm text-zinc-700">Subscribe to newsletter</span>
        </label>
      </div>
    </DemoBlock>

    <!-- Radio Button -->
    <DemoBlock label="Radio Button">
      <fieldset class="space-y-3">
        <legend class="font-heading text-sm font-semibold text-zinc-900 mb-2">Preferred Contact</legend>
        <label class="flex items-center gap-3 cursor-pointer">
          <input
            type="radio"
            name="contact-demo"
            checked
            class="form-radio appearance-none w-5 h-5 border border-zinc-300 bg-white transition-colors cursor-pointer shrink-0"
          />
          <span class="text-sm text-zinc-700">Email</span>
        </label>
        <label class="flex items-center gap-3 cursor-pointer">
          <input
            type="radio"
            name="contact-demo"
            class="form-radio appearance-none w-5 h-5 border border-zinc-300 bg-white transition-colors cursor-pointer shrink-0"
          />
          <span class="text-sm text-zinc-700">Phone</span>
        </label>
      </fieldset>
    </DemoBlock>

    <!-- Toggle / Switch -->
    <DemoBlock label="Toggle / Switch">
      <div class="space-y-4">
        <label class="flex items-center gap-3 cursor-pointer">
          <span class="relative inline-flex items-center w-11 h-6">
            <input type="checkbox" checked class="sr-only peer" />
            <span class="absolute inset-0 bg-zinc-300 peer-checked:bg-orange-500 transition-colors"></span>
            <span class="absolute top-0.5 left-0.5 w-5 h-5 bg-white transition-transform peer-checked:translate-x-5"></span>
          </span>
          <span class="text-sm text-zinc-700">Enable notifications</span>
        </label>
        <label class="flex items-center gap-3 cursor-pointer">
          <span class="relative inline-flex items-center w-11 h-6">
            <input type="checkbox" class="sr-only peer" />
            <span class="absolute inset-0 bg-zinc-300 peer-checked:bg-orange-500 transition-colors"></span>
            <span class="absolute top-0.5 left-0.5 w-5 h-5 bg-white transition-transform peer-checked:translate-x-5"></span>
          </span>
          <span class="text-sm text-zinc-700">Dark mode</span>
        </label>
      </div>
    </DemoBlock>

  </div>

  <!-- Full-width demos -->
  <DemoBlock label="Address (Structured)">
    <div class="max-w-lg space-y-4">
      <div>
        <label class="block font-heading text-sm font-semibold text-zinc-900 mb-1.5">Street Address</label>
        <input
          type="text"
          placeholder="123 Main St"
          class="border border-zinc-300 bg-white px-4 py-2.5 text-sm text-zinc-700 w-full focus:outline-none focus:border-zinc-500 transition-colors"
        />
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block font-heading text-sm font-semibold text-zinc-900 mb-1.5">City</label>
          <input
            type="text"
            placeholder="San Francisco"
            class="border border-zinc-300 bg-white px-4 py-2.5 text-sm text-zinc-700 w-full focus:outline-none focus:border-zinc-500 transition-colors"
          />
        </div>
        <div>
          <label class="block font-heading text-sm font-semibold text-zinc-900 mb-1.5">State / Region</label>
          <input
            type="text"
            placeholder="CA"
            class="border border-zinc-300 bg-white px-4 py-2.5 text-sm text-zinc-700 w-full focus:outline-none focus:border-zinc-500 transition-colors"
          />
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block font-heading text-sm font-semibold text-zinc-900 mb-1.5">ZIP / Postal Code</label>
          <input
            type="text"
            placeholder="94102"
            class="border border-zinc-300 bg-white px-4 py-2.5 text-sm text-zinc-700 w-full focus:outline-none focus:border-zinc-500 transition-colors"
          />
        </div>
        <div>
          <label class="block font-heading text-sm font-semibold text-zinc-900 mb-1.5">Country</label>
          <input
            type="text"
            placeholder="United States"
            class="border border-zinc-300 bg-white px-4 py-2.5 text-sm text-zinc-700 w-full focus:outline-none focus:border-zinc-500 transition-colors"
          />
        </div>
      </div>
    </div>
  </DemoBlock>

  <DemoBlock label="Textarea">
    <div class="max-w-lg">
      <label class="block font-heading text-sm font-semibold text-zinc-900 mb-1.5">Message</label>
      <textarea
        rows="4"
        placeholder="Tell us what you need..."
        class="border border-zinc-300 bg-white px-4 py-2.5 text-sm text-zinc-700 w-full focus:outline-none focus:border-zinc-500 transition-colors resize-y"
      ></textarea>
    </div>
  </DemoBlock>

  <!-- Assembled Form -->
  <div>
    <h4 class="mb-6">Assembled Form</h4>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

      <!-- Light variant -->
      <div>
        <span class="mb-2 block font-heading text-xs font-semibold uppercase tracking-wider text-zinc-500">Light</span>
        <div class="border border-zinc-200 bg-white p-8">
          <h5 class="text-zinc-900 mb-1">Contact Us</h5>
          <p class="text-sm text-zinc-500 mb-6">We'd love to hear from you. Fill out the form below.</p>
          <form class="space-y-5" onsubmit="return false;">
            <div>
              <label class="block font-heading text-sm font-semibold text-zinc-900 mb-1.5">Full Name</label>
              <input type="text" placeholder="Jane Doe" class="border border-zinc-300 bg-white px-4 py-2.5 text-sm text-zinc-700 w-full focus:outline-none focus:border-zinc-500 transition-colors" />
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block font-heading text-sm font-semibold text-zinc-900 mb-1.5">Email</label>
                <input type="email" placeholder="jane@example.com" class="border border-zinc-300 bg-white px-4 py-2.5 text-sm text-zinc-700 w-full focus:outline-none focus:border-zinc-500 transition-colors" />
              </div>
              <div>
                <label class="block font-heading text-sm font-semibold text-zinc-900 mb-1.5">Phone</label>
                <input type="tel" placeholder="+1 (555) 000-0000" class="border border-zinc-300 bg-white px-4 py-2.5 text-sm text-zinc-700 w-full focus:outline-none focus:border-zinc-500 transition-colors" />
              </div>
            </div>
            <div>
              <label class="block font-heading text-sm font-semibold text-zinc-900 mb-1.5">Street Address</label>
              <input type="text" placeholder="123 Main St" class="border border-zinc-300 bg-white px-4 py-2.5 text-sm text-zinc-700 w-full focus:outline-none focus:border-zinc-500 transition-colors" />
            </div>
            <div class="grid grid-cols-3 gap-4">
              <div>
                <label class="block font-heading text-sm font-semibold text-zinc-900 mb-1.5">City</label>
                <input type="text" placeholder="San Francisco" class="border border-zinc-300 bg-white px-4 py-2.5 text-sm text-zinc-700 w-full focus:outline-none focus:border-zinc-500 transition-colors" />
              </div>
              <div>
                <label class="block font-heading text-sm font-semibold text-zinc-900 mb-1.5">State</label>
                <input type="text" placeholder="CA" class="border border-zinc-300 bg-white px-4 py-2.5 text-sm text-zinc-700 w-full focus:outline-none focus:border-zinc-500 transition-colors" />
              </div>
              <div>
                <label class="block font-heading text-sm font-semibold text-zinc-900 mb-1.5">ZIP</label>
                <input type="text" placeholder="94102" class="border border-zinc-300 bg-white px-4 py-2.5 text-sm text-zinc-700 w-full focus:outline-none focus:border-zinc-500 transition-colors" />
              </div>
            </div>
            <div>
              <label class="block font-heading text-sm font-semibold text-zinc-900 mb-1.5">Message</label>
              <textarea rows="3" placeholder="Tell us what you need..." class="border border-zinc-300 bg-white px-4 py-2.5 text-sm text-zinc-700 w-full focus:outline-none focus:border-zinc-500 transition-colors resize-y"></textarea>
            </div>
            <label class="flex items-center gap-3 cursor-pointer">
              <input type="checkbox" class="form-checkbox appearance-none w-5 h-5 border border-zinc-300 bg-white checked:bg-orange-500 checked:border-orange-500 transition-colors cursor-pointer shrink-0" />
              <span class="text-sm text-zinc-700">I agree to the Privacy Policy</span>
            </label>
            <label class="flex items-center gap-3 cursor-pointer">
              <span class="relative inline-flex items-center w-11 h-6">
                <input type="checkbox" class="sr-only peer" />
                <span class="absolute inset-0 bg-zinc-300 peer-checked:bg-orange-500 transition-colors"></span>
                <span class="absolute top-0.5 left-0.5 w-5 h-5 bg-white transition-transform peer-checked:translate-x-5"></span>
              </span>
              <span class="text-sm text-zinc-700">Subscribe to updates</span>
            </label>
            <div class="flex justify-end">
              <button type="submit" class="group inline-flex items-center justify-center font-semibold focus:outline-hidden focus-visible:outline-2 focus-visible:outline-offset-2 bg-orange-500 text-black hover:bg-orange-600 active:bg-orange-500 focus-visible:outline-orange-500 px-8 py-4 text-base transition duration-150 ease-in-out font-mono cursor-pointer">
                Send Message
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- Dark variant -->
      <div>
        <span class="mb-2 block font-heading text-xs font-semibold uppercase tracking-wider text-zinc-500">Dark</span>
        <div class="border border-zinc-700 bg-zinc-900 p-8">
          <h5 class="text-zinc-100 mb-1">Contact Us</h5>
          <p class="text-sm text-zinc-400 mb-6">We'd love to hear from you. Fill out the form below.</p>
          <form class="space-y-5" onsubmit="return false;">
            <div>
              <label class="block font-heading text-sm font-semibold text-zinc-100 mb-1.5">Full Name</label>
              <input type="text" placeholder="Jane Doe" class="border border-zinc-600 bg-zinc-800 px-4 py-2.5 text-sm text-zinc-100 w-full focus:outline-none focus:border-zinc-400 transition-colors placeholder:text-zinc-500" />
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block font-heading text-sm font-semibold text-zinc-100 mb-1.5">Email</label>
                <input type="email" placeholder="jane@example.com" class="border border-zinc-600 bg-zinc-800 px-4 py-2.5 text-sm text-zinc-100 w-full focus:outline-none focus:border-zinc-400 transition-colors placeholder:text-zinc-500" />
              </div>
              <div>
                <label class="block font-heading text-sm font-semibold text-zinc-100 mb-1.5">Phone</label>
                <input type="tel" placeholder="+1 (555) 000-0000" class="border border-zinc-600 bg-zinc-800 px-4 py-2.5 text-sm text-zinc-100 w-full focus:outline-none focus:border-zinc-400 transition-colors placeholder:text-zinc-500" />
              </div>
            </div>
            <div>
              <label class="block font-heading text-sm font-semibold text-zinc-100 mb-1.5">Street Address</label>
              <input type="text" placeholder="123 Main St" class="border border-zinc-600 bg-zinc-800 px-4 py-2.5 text-sm text-zinc-100 w-full focus:outline-none focus:border-zinc-400 transition-colors placeholder:text-zinc-500" />
            </div>
            <div class="grid grid-cols-3 gap-4">
              <div>
                <label class="block font-heading text-sm font-semibold text-zinc-100 mb-1.5">City</label>
                <input type="text" placeholder="San Francisco" class="border border-zinc-600 bg-zinc-800 px-4 py-2.5 text-sm text-zinc-100 w-full focus:outline-none focus:border-zinc-400 transition-colors placeholder:text-zinc-500" />
              </div>
              <div>
                <label class="block font-heading text-sm font-semibold text-zinc-100 mb-1.5">State</label>
                <input type="text" placeholder="CA" class="border border-zinc-600 bg-zinc-800 px-4 py-2.5 text-sm text-zinc-100 w-full focus:outline-none focus:border-zinc-400 transition-colors placeholder:text-zinc-500" />
              </div>
              <div>
                <label class="block font-heading text-sm font-semibold text-zinc-100 mb-1.5">ZIP</label>
                <input type="text" placeholder="94102" class="border border-zinc-600 bg-zinc-800 px-4 py-2.5 text-sm text-zinc-100 w-full focus:outline-none focus:border-zinc-400 transition-colors placeholder:text-zinc-500" />
              </div>
            </div>
            <div>
              <label class="block font-heading text-sm font-semibold text-zinc-100 mb-1.5">Message</label>
              <textarea rows="3" placeholder="Tell us what you need..." class="border border-zinc-600 bg-zinc-800 px-4 py-2.5 text-sm text-zinc-100 w-full focus:outline-none focus:border-zinc-400 transition-colors resize-y placeholder:text-zinc-500"></textarea>
            </div>
            <label class="flex items-center gap-3 cursor-pointer">
              <input type="checkbox" class="form-checkbox appearance-none w-5 h-5 border border-zinc-600 bg-zinc-800 checked:bg-orange-500 checked:border-orange-500 transition-colors cursor-pointer shrink-0" />
              <span class="text-sm text-zinc-300">I agree to the Privacy Policy</span>
            </label>
            <label class="flex items-center gap-3 cursor-pointer">
              <span class="relative inline-flex items-center w-11 h-6">
                <input type="checkbox" class="sr-only peer" />
                <span class="absolute inset-0 bg-zinc-600 peer-checked:bg-orange-500 transition-colors"></span>
                <span class="absolute top-0.5 left-0.5 w-5 h-5 bg-zinc-100 transition-transform peer-checked:translate-x-5"></span>
              </span>
              <span class="text-sm text-zinc-300">Subscribe to updates</span>
            </label>
            <div class="flex justify-end">
              <button type="submit" class="group inline-flex items-center justify-center font-semibold focus:outline-hidden focus-visible:outline-2 focus-visible:outline-offset-2 bg-orange-500 text-black hover:bg-orange-600 active:bg-orange-500 focus-visible:outline-orange-500 px-8 py-4 text-base transition duration-150 ease-in-out font-mono cursor-pointer">
                Send Message
              </button>
            </div>
          </form>
        </div>
      </div>

    </div>
  </div>

  <!-- ─── Styling Guidelines ─── -->
  <div class="mt-16 border-t border-zinc-200 pt-10 space-y-10">
    <h3>Styling Guidelines</h3>

    <!-- Input Tokens -->
    <div>
      <h4>Input Tokens</h4>
      <p class="mt-2 text-sm text-zinc-600">
        Classes for text-based inputs (<code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">text</code>, <code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">email</code>, <code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">tel</code>, <code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">textarea</code>).
      </p>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full text-sm font-heading">
          <thead>
            <tr class="border-b border-zinc-200 text-left">
              <th class="pb-3 pr-6 font-semibold text-zinc-900">Element</th>
              <th class="pb-3 pr-6 font-semibold text-zinc-900">Light Classes</th>
              <th class="pb-3 font-semibold text-zinc-900">Dark Classes</th>
            </tr>
          </thead>
          <tbody class="text-zinc-700">
            <tr class="border-b border-zinc-100">
              <td class="py-3 pr-6">Input</td>
              <td class="py-3 pr-6"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">border border-zinc-300 bg-white px-4 py-2.5 text-sm text-zinc-700</code></td>
              <td class="py-3"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">border border-zinc-600 bg-zinc-800 px-4 py-2.5 text-sm text-zinc-100</code></td>
            </tr>
            <tr class="border-b border-zinc-100">
              <td class="py-3 pr-6">Textarea</td>
              <td class="py-3 pr-6"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">Same as input + resize-y</code></td>
              <td class="py-3"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">Same as input + resize-y</code></td>
            </tr>
            <tr class="border-b border-zinc-100">
              <td class="py-3 pr-6">Label</td>
              <td class="py-3 pr-6"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">block font-heading text-sm font-semibold text-zinc-900 mb-1.5</code></td>
              <td class="py-3"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">block font-heading text-sm font-semibold text-zinc-100 mb-1.5</code></td>
            </tr>
            <tr class="border-b border-zinc-100">
              <td class="py-3 pr-6">Helper text</td>
              <td class="py-3 pr-6"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">text-xs text-zinc-500 mt-1</code></td>
              <td class="py-3"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">text-xs text-zinc-400 mt-1</code></td>
            </tr>
            <tr>
              <td class="py-3 pr-6">Placeholder</td>
              <td class="py-3 pr-6"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">Default browser (zinc-400)</code></td>
              <td class="py-3"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">placeholder:text-zinc-500</code></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Control Tokens -->
    <div>
      <h4>Control Tokens</h4>
      <p class="mt-2 text-sm text-zinc-600">
        Checkbox, radio, and toggle all use <code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">appearance-none</code> to strip browser defaults. Toggle uses the <code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">peer</code> pattern with a hidden <code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">sr-only</code> checkbox.
      </p>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full text-sm font-heading">
          <thead>
            <tr class="border-b border-zinc-200 text-left">
              <th class="pb-3 pr-6 font-semibold text-zinc-900">Control</th>
              <th class="pb-3 pr-6 font-semibold text-zinc-900">Default State</th>
              <th class="pb-3 pr-6 font-semibold text-zinc-900">Checked State</th>
              <th class="pb-3 font-semibold text-zinc-900">Notes</th>
            </tr>
          </thead>
          <tbody class="text-zinc-700">
            <tr class="border-b border-zinc-100">
              <td class="py-3 pr-6">Checkbox</td>
              <td class="py-3 pr-6"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">w-5 h-5 border border-zinc-300 bg-white</code></td>
              <td class="py-3 pr-6"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">checked:bg-orange-500 checked:border-orange-500</code></td>
              <td class="py-3">SVG checkmark via CSS background-image</td>
            </tr>
            <tr class="border-b border-zinc-100">
              <td class="py-3 pr-6">Radio</td>
              <td class="py-3 pr-6"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">w-5 h-5 border border-zinc-300 bg-white</code></td>
              <td class="py-3 pr-6"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">bg-orange-500 + inset box-shadow</code></td>
              <td class="py-3">Square shape (0px radius), inset dot via box-shadow</td>
            </tr>
            <tr>
              <td class="py-3 pr-6">Toggle</td>
              <td class="py-3 pr-6"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">w-11 h-6 bg-zinc-300</code></td>
              <td class="py-3 pr-6"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">peer-checked:bg-orange-500 + translate-x-5</code></td>
              <td class="py-3">Hidden sr-only checkbox + peer siblings for track and knob</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- States -->
    <div>
      <h4>States</h4>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full text-sm font-heading">
          <thead>
            <tr class="border-b border-zinc-200 text-left">
              <th class="pb-3 pr-6 font-semibold text-zinc-900">State</th>
              <th class="pb-3 pr-6 font-semibold text-zinc-900">Border</th>
              <th class="pb-3 pr-6 font-semibold text-zinc-900">Background</th>
              <th class="pb-3 pr-6 font-semibold text-zinc-900">Label Color</th>
              <th class="pb-3 font-semibold text-zinc-900">Description</th>
            </tr>
          </thead>
          <tbody class="text-zinc-700">
            <tr class="border-b border-zinc-100">
              <td class="py-3 pr-6 font-semibold">Default</td>
              <td class="py-3 pr-6"><span class="inline-block w-3 h-3 bg-zinc-300 mr-2 align-middle"></span>zinc-300</td>
              <td class="py-3 pr-6"><span class="inline-block w-3 h-3 bg-white border border-zinc-200 mr-2 align-middle"></span>white</td>
              <td class="py-3 pr-6">zinc-900</td>
              <td class="py-3">Resting state</td>
            </tr>
            <tr class="border-b border-zinc-100">
              <td class="py-3 pr-6 font-semibold">Focus</td>
              <td class="py-3 pr-6"><span class="inline-block w-3 h-3 bg-zinc-500 mr-2 align-middle"></span>zinc-500</td>
              <td class="py-3 pr-6"><span class="inline-block w-3 h-3 bg-white border border-zinc-200 mr-2 align-middle"></span>white</td>
              <td class="py-3 pr-6">zinc-900</td>
              <td class="py-3"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">focus:border-zinc-500</code>, no outline</td>
            </tr>
            <tr class="border-b border-zinc-100">
              <td class="py-3 pr-6 font-semibold">Error</td>
              <td class="py-3 pr-6"><span class="inline-block w-3 h-3 bg-red-500 mr-2 align-middle"></span>red-500 (2px)</td>
              <td class="py-3 pr-6"><span class="inline-block w-3 h-3 bg-red-50 border border-zinc-200 mr-2 align-middle"></span>red-50</td>
              <td class="py-3 pr-6">zinc-900</td>
              <td class="py-3">Label stays default; use <code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">border-2 border-red-500</code>, error message in red-700</td>
            </tr>
            <tr>
              <td class="py-3 pr-6 font-semibold">Disabled</td>
              <td class="py-3 pr-6"><span class="inline-block w-3 h-3 bg-zinc-200 mr-2 align-middle"></span>zinc-200</td>
              <td class="py-3 pr-6"><span class="inline-block w-3 h-3 bg-zinc-50 border border-zinc-200 mr-2 align-middle"></span>zinc-50</td>
              <td class="py-3 pr-6">zinc-400</td>
              <td class="py-3"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">opacity-50 cursor-not-allowed</code></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Spacing Rules -->
    <div>
      <h4>Spacing Rules</h4>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full text-sm font-heading">
          <thead>
            <tr class="border-b border-zinc-200 text-left">
              <th class="pb-3 pr-6 font-semibold text-zinc-900">Relationship</th>
              <th class="pb-3 pr-6 font-semibold text-zinc-900">Value</th>
              <th class="pb-3 font-semibold text-zinc-900">Class</th>
            </tr>
          </thead>
          <tbody class="text-zinc-700">
            <tr class="border-b border-zinc-100">
              <td class="py-3 pr-6">Label to input</td>
              <td class="py-3 pr-6">6px</td>
              <td class="py-3"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">mb-1.5</code></td>
            </tr>
            <tr class="border-b border-zinc-100">
              <td class="py-3 pr-6">Between fields</td>
              <td class="py-3 pr-6">20px</td>
              <td class="py-3"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">space-y-5</code></td>
            </tr>
            <tr class="border-b border-zinc-100">
              <td class="py-3 pr-6">Inline field gap</td>
              <td class="py-3 pr-6">16px</td>
              <td class="py-3"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">gap-4</code></td>
            </tr>
            <tr class="border-b border-zinc-100">
              <td class="py-3 pr-6">Form padding (in card)</td>
              <td class="py-3 pr-6">32px</td>
              <td class="py-3"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">p-8</code></td>
            </tr>
            <tr>
              <td class="py-3 pr-6">Helper text to input</td>
              <td class="py-3 pr-6">4px</td>
              <td class="py-3"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">mt-1</code></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Dark Mode Token Swap -->
    <div>
      <h4>Dark Mode Token Swap</h4>
      <p class="mt-2 text-sm text-zinc-600">
        When placing forms on dark backgrounds (hero, footer), swap these tokens.
      </p>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full text-sm font-heading">
          <thead>
            <tr class="border-b border-zinc-200 text-left">
              <th class="pb-3 pr-6 font-semibold text-zinc-900">Element</th>
              <th class="pb-3 pr-6 font-semibold text-zinc-900">Light</th>
              <th class="pb-3 font-semibold text-zinc-900">Dark</th>
            </tr>
          </thead>
          <tbody class="text-zinc-700">
            <tr class="border-b border-zinc-100">
              <td class="py-3 pr-6">Card background</td>
              <td class="py-3 pr-6"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">bg-white border-zinc-200</code></td>
              <td class="py-3"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">bg-zinc-900 border-zinc-700</code></td>
            </tr>
            <tr class="border-b border-zinc-100">
              <td class="py-3 pr-6">Input border</td>
              <td class="py-3 pr-6"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">border-zinc-300</code></td>
              <td class="py-3"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">border-zinc-600</code></td>
            </tr>
            <tr class="border-b border-zinc-100">
              <td class="py-3 pr-6">Input background</td>
              <td class="py-3 pr-6"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">bg-white</code></td>
              <td class="py-3"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">bg-zinc-800</code></td>
            </tr>
            <tr class="border-b border-zinc-100">
              <td class="py-3 pr-6">Input text</td>
              <td class="py-3 pr-6"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">text-zinc-700</code></td>
              <td class="py-3"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">text-zinc-100</code></td>
            </tr>
            <tr class="border-b border-zinc-100">
              <td class="py-3 pr-6">Placeholder</td>
              <td class="py-3 pr-6"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">Default</code></td>
              <td class="py-3"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">placeholder:text-zinc-500</code></td>
            </tr>
            <tr class="border-b border-zinc-100">
              <td class="py-3 pr-6">Focus border</td>
              <td class="py-3 pr-6"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">focus:border-zinc-500</code></td>
              <td class="py-3"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">focus:border-zinc-400</code></td>
            </tr>
            <tr class="border-b border-zinc-100">
              <td class="py-3 pr-6">Toggle track (off)</td>
              <td class="py-3 pr-6"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">bg-zinc-300</code></td>
              <td class="py-3"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">bg-zinc-600</code></td>
            </tr>
            <tr>
              <td class="py-3 pr-6">Checkbox (unchecked)</td>
              <td class="py-3 pr-6"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">border-zinc-300 bg-white</code></td>
              <td class="py-3"><code class="bg-zinc-100 px-1.5 py-0.5 text-xs font-mono text-zinc-700">border-zinc-600 bg-zinc-800</code></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

</div>
