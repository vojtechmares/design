---
/**
 * States — Form validation and interactive states.
 */
import DocSection from './ui/DocSection.astro';
import DemoBlock from './ui/DemoBlock.astro';
---

<DocSection id="states" title="States" subtitle="Form validation and interactive states.">
<div class="space-y-8">

  <!-- Danger state reference -->
  <div>
    <h4>Danger / Error States</h4>
    <p class="mt-2 text-sm text-zinc-600">
      Error and danger states use the red palette consistently across all interactive elements: form inputs, inline messages, and background fills.
    </p>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full text-sm font-heading">
        <thead>
          <tr class="border-b border-zinc-200 text-left">
            <th class="pb-3 pr-6 font-semibold text-zinc-900">Element</th>
            <th class="pb-3 pr-6 font-semibold text-zinc-900">Token</th>
            <th class="pb-3 font-semibold text-zinc-900">Usage</th>
          </tr>
        </thead>
        <tbody class="text-zinc-700">
          <tr class="border-b border-zinc-100">
            <td class="py-3 pr-6">Error border</td>
            <td class="py-3 pr-6"><span class="inline-block w-3 h-3 bg-red-500 mr-2 align-middle"></span>Red-500</td>
            <td class="py-3">Input borders, callout left border</td>
          </tr>
          <tr class="border-b border-zinc-100">
            <td class="py-3 pr-6">Error text</td>
            <td class="py-3 pr-6"><span class="inline-block w-3 h-3 bg-red-700 mr-2 align-middle"></span>Red-700</td>
            <td class="py-3">Inline error messages</td>
          </tr>
          <tr>
            <td class="py-3 pr-6">Error background</td>
            <td class="py-3 pr-6"><span class="inline-block w-3 h-3 bg-red-50 border border-zinc-200 mr-2 align-middle"></span>Red-50</td>
            <td class="py-3">Input group fills, danger callout background</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Form validation demo -->
  <DemoBlock label="Form Validation — Error">
    <div class="max-w-xs space-y-2">
      <label class="block font-heading font-semibold text-zinc-900">
        Password
      </label>
      <input
        type="text"
        value="123"
        readonly
        class="w-full border-2 border-red-500 px-3 py-2 text-zinc-900"
      />
      <p class="flex items-center gap-1 text-sm text-red-700">
        <span class="font-heading">ⓘ</span> Password is too short
      </p>
    </div>
  </DemoBlock>


</div>
</DocSection>
