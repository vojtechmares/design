---
/**
 * DosAndDonts — Shows contrast examples with DO and DON'T labels.
 */
import Section from './ui/Section.astro';
import DemoBlock from './ui/DemoBlock.astro';
---

<Section id="dos-donts" title="Do's & Don'ts" subtitle="Contrast and accessibility guidelines.">
<div class="grid grid-cols-1 gap-8 sm:grid-cols-2">
  <!-- DO -->
  <DemoBlock label="Do">
    <div class="space-y-3">
      <div class="inline-block bg-orange-500 px-6 py-2 font-heading font-semibold text-black">
        Black text
      </div>
      <div class="flex items-center gap-2">
        <span class="font-heading text-sm font-semibold" style="color: #059669;">
          ✓ DO
        </span>
      </div>
      <p class="text-sm text-zinc-600">High contrast on orange.</p>
    </div>
  </DemoBlock>

  <!-- DON'T -->
  <DemoBlock label="Don't">
    <div class="space-y-3">
      <div class="inline-block bg-orange-500 px-6 py-2 font-heading font-semibold text-white">
        White text
      </div>
      <div class="flex items-center gap-2">
        <span class="font-heading text-sm font-semibold text-red-700">
          ✗ DON'T
        </span>
      </div>
      <p class="text-sm text-zinc-600">Low contrast (poor readability).</p>
    </div>
  </DemoBlock>

  <!-- DO: error state -->
  <DemoBlock label="Do">
    <div class="space-y-3">
      <div class="max-w-xs space-y-2">
        <label class="block font-heading text-sm font-semibold text-zinc-900">Password</label>
        <input
          type="text"
          value="123"
          readonly
          class="w-full border-2 border-red-500 bg-white px-3 py-2 text-zinc-900"
        />
        <p class="flex items-center gap-1 text-sm text-red-700">
          <span class="font-heading">ⓘ</span> Password is too short
        </p>
      </div>
      <div class="flex items-center gap-2">
        <span class="font-heading text-sm font-semibold" style="color: #059669;">
          ✓ DO
        </span>
      </div>
      <p class="text-sm text-zinc-600">Border outline + inline error text is sufficient.</p>
    </div>
  </DemoBlock>

  <!-- DON'T: error state with background fill -->
  <DemoBlock label="Don't">
    <div class="space-y-3">
      <div class="max-w-xs space-y-2 bg-red-50 p-4">
        <label class="block font-heading text-sm font-semibold text-red-700">Password</label>
        <input
          type="text"
          value="123"
          readonly
          class="w-full border-2 border-red-500 bg-white px-3 py-2 text-zinc-900"
        />
        <p class="flex items-center gap-1 text-sm text-red-700">
          <span class="font-heading">ⓘ</span> Password is too short
        </p>
      </div>
      <div class="flex items-center gap-2">
        <span class="font-heading text-sm font-semibold text-red-700">
          ✗ DON'T
        </span>
      </div>
      <p class="text-sm text-zinc-600">Red background fill is too heavy — it breaks visual hierarchy.</p>
    </div>
  </DemoBlock>
</div>
</Section>
