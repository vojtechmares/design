---
import Section from './ui/Section.astro';
import ColorSwatch from './ui/ColorSwatch.astro';
import DemoBlock from './ui/DemoBlock.astro';
---

<Section id="colors" title="Colors & Palette" subtitle="Brand colors, text palette, and background combinations.">

  <!-- Primary Color -->
  <div>
    <h3>Primary Color</h3>
    <div class="mt-4 grid gap-6 md:grid-cols-3">
      <ColorSwatch
        name="Orange-500"
        hex="#f97316"
        tailwind="Orange-500"
        rgb="249, 115, 22"
        usage="Primary button backgrounds, action icons, call-to-action areas. Text must be black (#000)."
      />
      <ColorSwatch
        name="Orange-50"
        hex="#fff7ed"
        tailwind="Orange-50"
        usage="Secondary buttons, light accents."
      />
      <ColorSwatch
        name="Orange-600"
        hex="#ea580c"
        tailwind="Orange-600"
        usage="Primary button hover state."
      />
    </div>
  </div>

  <!-- Text Accent -->
  <div class="mt-12">
    <h3>Text Accent</h3>
    <div class="mt-4 max-w-sm">
      <ColorSwatch
        name="Amber-800"
        hex="#92400E"
        rgb="146, 64, 14"
        tailwind="Amber-800"
        usage="Text links on white background, highlighted text, interactive text, labels. WCAG AA contrast."
      />
    </div>
  </div>

  <!-- Danger -->
  <div class="mt-12">
    <h3>Danger</h3>
    <div class="mt-4 grid gap-6 md:grid-cols-2">
      <ColorSwatch
        name="Red-500"
        hex="#EF4444"
        tailwind="Red-500"
        rgb="239, 68, 68"
        usage="Danger borders, error highlights, destructive action buttons, form validation borders."
      />
      <ColorSwatch
        name="Red-50"
        hex="#FEF2F2"
        tailwind="Red-50"
        rgb="254, 242, 242"
        usage="Danger backgrounds, error state fills, danger callout background."
      />
    </div>
  </div>

  <!-- Dark Background -->
  <div class="mt-12">
    <h3>Dark Background</h3>
    <div class="mt-4 grid gap-6 md:grid-cols-2">
      <ColorSwatch
        name="Zinc-900"
        hex="#18181B"
        tailwind="Zinc-900"
        usage="Headings (h1-h5), dark section backgrounds (hero, footer), code blocks."
      />
      <ColorSwatch
        name="Zinc-100"
        hex="#F4F4F5"
        tailwind="Zinc-100"
        usage="Text on dark background."
      />
    </div>
  </div>

  <!-- Zinc Text Palette -->
  <div class="mt-12">
    <h3>Zinc Text Palette</h3>
    <div class="mt-4 grid gap-6 grid-cols-2 md:grid-cols-4">
      <ColorSwatch
        name="Zinc-700"
        hex="#3F3F46"
        tailwind="Zinc-700"
        usage="Body text on light background."
      />
      <ColorSwatch
        name="Zinc-500"
        hex="#71717A"
        tailwind="Zinc-500"
        usage="Secondary text, captions (small)."
      />
      <ColorSwatch
        name="Zinc-100"
        hex="#F4F4F5"
        tailwind="Zinc-100"
        usage="Text on dark background (Zinc-900)."
      />
      <ColorSwatch
        name="Zinc-300"
        hex="#D4D4D8"
        tailwind="Zinc-300"
        usage="Secondary text on dark background."
      />
    </div>
  </div>

  <!-- Background Combinations -->
  <div class="mt-12">
    <h3>Background Combinations</h3>
    <div class="mt-4 grid gap-6 md:grid-cols-2">
      <DemoBlock label="Light background">
        <div class="bg-zinc-100 p-6">
          <div class="bg-white p-4 border border-zinc-200">
            <p class="text-sm text-zinc-700">Block on light background</p>
          </div>
        </div>
      </DemoBlock>
      <DemoBlock label="Dark background" variant="dark">
        <div class="bg-zinc-900 p-6">
          <div class="bg-zinc-800 p-4 border border-zinc-700">
            <p class="text-sm text-zinc-100">Block on dark background</p>
          </div>
        </div>
      </DemoBlock>
    </div>
  </div>

</Section>
