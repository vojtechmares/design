---
import { Type, Palette, Code, LayoutGrid, Triangle, Sparkles, PanelTop, Square, CreditCard, MousePointerClick, TextCursorInput, Loader, ToggleLeft, MessageSquareQuote, CheckCircle, Menu, X, Home, FileText, RectangleVertical, Presentation } from '@lucide/astro';
import type { NavGroup } from '../data/design-system-nav';

interface Props {
  title: string;
  navGroups: NavGroup[];
  theme?: 'light' | 'dark';
}

const { title, navGroups, theme = 'light' } = Astro.props;

const sectionIds = navGroups.flatMap((g) => g.items.map((i) => i.id));

const iconMap: Record<string, any> = {
  Type, Palette, Code, LayoutGrid, Triangle, Sparkles, PanelTop, Square, CreditCard, MousePointerClick, TextCursorInput, Loader, ToggleLeft, MessageSquareQuote, CheckCircle, FileText, RectangleVertical, Presentation,
};

const isDark = theme === 'dark';
const chrome = {
  panelBg: isDark ? 'bg-zinc-900' : 'bg-white',
  border: isDark ? 'border-zinc-800' : 'border-zinc-200',
  titleText: isDark ? 'text-zinc-100' : 'text-zinc-900',
  iconBtn: isDark ? 'text-zinc-400 hover:text-zinc-100' : 'text-zinc-600 hover:text-zinc-900',
  link: isDark
    ? 'text-zinc-300 hover:text-zinc-100 hover:bg-zinc-800'
    : 'text-zinc-600 hover:text-zinc-900 hover:bg-zinc-100',
};
---

<div id="sidebar-root" data-section-ids={JSON.stringify(sectionIds)} data-theme={theme} class="contents">
<!-- Mobile top bar -->
<div class:list={["fixed top-0 left-0 right-0 z-40 flex items-center justify-between border-b px-4 h-14 lg:hidden", chrome.panelBg, chrome.border]}>
  <span class:list={["font-display text-base", chrome.titleText]}><span class="text-zinc-400 text-xs font-medium uppercase tracking-wider">Mares Design</span> <span class="font-bold">/ {title}</span></span>
  <button id="sidebar-open-btn" class:list={["p-2", chrome.iconBtn]} aria-label="Open menu">
    <Menu size={24} />
  </button>
</div>

<!-- Mobile overlay backdrop -->
<div id="sidebar-backdrop" class="fixed inset-0 z-40 bg-black/40 hidden lg:hidden"></div>

<!-- Mobile overlay sidebar -->
<div id="sidebar-mobile" class:list={["fixed inset-y-0 left-0 z-50 w-[280px] border-r transform -translate-x-full transition-transform duration-200 ease-in-out lg:hidden overflow-y-auto", chrome.panelBg, chrome.border]}>
  <div class="flex items-center justify-between p-6 pb-0">
    <div>
      <div class="font-display text-xs font-medium text-zinc-400 uppercase tracking-wider">Mares Design</div>
      <div class:list={["font-display font-bold text-lg", chrome.titleText]}>{title}</div>
      <div class="font-heading text-xs text-zinc-400">v1.0</div>
    </div>
    <button id="sidebar-close-btn" class:list={["p-2", chrome.iconBtn]} aria-label="Close menu">
      <X size={20} />
    </button>
  </div>
  <nav class="p-6 pt-2">
    <a href="/" class:list={["flex items-center gap-2.5 text-sm font-heading py-1.5 px-3 mb-4 no-underline transition-colors mt-2", chrome.link]}>
      <Home size={16} class="shrink-0" />
      <span>Home</span>
    </a>
    {navGroups.map((group) => (
      <div>
        <h5 class="uppercase text-xs font-heading font-semibold text-zinc-400 tracking-wider mt-8 mb-3 first:mt-4">{group.title}</h5>
        <ul class="space-y-0.5">
          {group.items.map((item) => {
            const IconComponent = iconMap[item.icon];
            return (
              <li>
                <a
                  href={`#${item.id}`}
                  data-section={item.id}
                  class:list={["sidebar-link flex items-center gap-2.5 text-sm font-heading py-1.5 px-3 no-underline transition-colors", chrome.link]}
                >
                  <IconComponent size={16} class="shrink-0" />
                  <span>{item.label}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </nav>
</div>

<!-- Desktop sidebar -->
<aside class:list={["hidden lg:block lg:w-[260px] lg:shrink-0 lg:fixed lg:inset-y-0 lg:left-0 lg:overflow-y-auto border-r", chrome.panelBg, chrome.border]}>
  <div class="p-6">
    <div class="font-display text-xs font-medium text-zinc-400 uppercase tracking-wider">Mares Design</div>
    <div class:list={["font-display font-bold text-lg", chrome.titleText]}>{title}</div>
    <div class="font-heading text-xs text-zinc-400">v1.0</div>
  </div>
  <nav class="px-6 pb-6">
    <a href="/" class:list={["flex items-center gap-2.5 text-sm font-heading py-1.5 px-3 mb-4 no-underline transition-colors", chrome.link]}>
      <Home size={16} class="shrink-0" />
      <span>Home</span>
    </a>
    {navGroups.map((group) => (
      <div>
        <h5 class="uppercase text-xs font-heading font-semibold text-zinc-400 tracking-wider mt-8 mb-3 first:mt-2">{group.title}</h5>
        <ul class="space-y-0.5">
          {group.items.map((item) => {
            const IconComponent = iconMap[item.icon];
            return (
              <li>
                <a
                  href={`#${item.id}`}
                  data-section={item.id}
                  class:list={["sidebar-link flex items-center gap-2.5 text-sm font-heading py-1.5 px-3 no-underline transition-colors", chrome.link]}
                >
                  <IconComponent size={16} class="shrink-0" />
                  <span>{item.label}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </nav>
</aside>
</div>

<script>
  // --- Mobile sidebar toggle ---
  const openBtn = document.getElementById('sidebar-open-btn');
  const closeBtn = document.getElementById('sidebar-close-btn');
  const backdrop = document.getElementById('sidebar-backdrop');
  const mobileSidebar = document.getElementById('sidebar-mobile');

  function openMobileSidebar() {
    mobileSidebar?.classList.remove('-translate-x-full');
    mobileSidebar?.classList.add('translate-x-0');
    backdrop?.classList.remove('hidden');
  }

  function closeMobileSidebar() {
    mobileSidebar?.classList.add('-translate-x-full');
    mobileSidebar?.classList.remove('translate-x-0');
    backdrop?.classList.add('hidden');
  }

  openBtn?.addEventListener('click', openMobileSidebar);
  closeBtn?.addEventListener('click', closeMobileSidebar);
  backdrop?.addEventListener('click', closeMobileSidebar);

  // Close mobile sidebar when a nav link is clicked
  mobileSidebar?.querySelectorAll('a[data-section]').forEach((link) => {
    link.addEventListener('click', closeMobileSidebar);
  });

  // --- Scroll spy ---
  const root = document.getElementById('sidebar-root');
  const sectionIds: string[] = JSON.parse(root?.dataset.sectionIds || '[]');
  const theme = root?.dataset.theme === 'dark' ? 'dark' : 'light';

  const activeClasses = theme === 'dark'
    ? ['bg-zinc-800', 'text-zinc-100', 'border-l-2', 'border-orange-500']
    : ['bg-orange-50', 'text-zinc-900', 'border-l-2', 'border-orange-500'];
  const idleClass = theme === 'dark' ? 'text-zinc-300' : 'text-zinc-600';

  const sections = sectionIds
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  const allLinks = document.querySelectorAll<HTMLAnchorElement>('a.sidebar-link[data-section]');

  function setActiveLink(sectionId: string) {
    allLinks.forEach((link) => {
      if (link.dataset.section === sectionId) {
        link.classList.add(...activeClasses);
        link.classList.remove(idleClass);
      } else {
        link.classList.remove(...activeClasses);
        link.classList.add(idleClass);
      }
    });
  }

  if (sections.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            setActiveLink(entry.target.id);
          }
        }
      },
      { threshold: 0.2 }
    );

    sections.forEach((section) => observer.observe(section));
  }
</script>
