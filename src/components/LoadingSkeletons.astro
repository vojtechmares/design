---
/**
 * LoadingSkeletons — Shows loading skeleton patterns.
 */
import Section from './ui/Section.astro';
import DemoBlock from './ui/DemoBlock.astro';
---

<Section id="loading-skeletons" title="Loading & Skeletons" subtitle="Skeleton placeholders and shimmer animations.">
<div class="space-y-8">
  <DemoBlock label="Skeleton Loading">
    <div class="flex items-start gap-4">
      <div class="h-12 w-12 rounded-none bg-zinc-200"></div>
      <div class="flex flex-col gap-3">
        <div
          class="h-4 w-48 rounded-none"
          style="background: linear-gradient(90deg, #E4E4E7 25%, #F4F4F5 50%, #E4E4E7 75%); background-size: 200% 100%; animation: shimmer 1.5s infinite;"
        ></div>
        <div
          class="h-4 w-64 rounded-none"
          style="background: linear-gradient(90deg, #E4E4E7 25%, #F4F4F5 50%, #E4E4E7 75%); background-size: 200% 100%; animation: shimmer 1.5s infinite;"
        ></div>
      </div>
    </div>
  </DemoBlock>
</div>
</Section>
