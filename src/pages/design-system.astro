---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import Typography from '../components/Typography.astro';
import Colors from '../components/Colors.astro';
import CodeColors from '../components/CodeColors.astro';
import ContainerSpacing from '../components/ContainerSpacing.astro';
import Shapes from '../components/Shapes.astro';
import Animations from '../components/Animations.astro';
import ContextualBlocks from '../components/ContextualBlocks.astro';
import Hero from '../components/Hero.astro';
import Card from '../components/Card.astro';
import Buttons from '../components/Buttons.astro';
import FormsInputs from '../components/FormsInputs.astro';
import LoadingSkeletons from '../components/LoadingSkeletons.astro';
import States from '../components/States.astro';
import Callout from '../components/Callout.astro';
import DosAndDonts from '../components/DosAndDonts.astro';
---

<Layout title="Design System — Mares Design" hasSidebar>
  <Sidebar slot="sidebar" title="Design System" />

  <section class="hero pb-4">
    <h1>Design System</h1>
    <p class="mt-2 text-base text-zinc-500">Complete visual style specification. This document serves as the single source of truth for design and web development.</p>
  </section>

  <div class="mt-20 mb-2">
    <span class="uppercase text-xs font-heading font-semibold text-zinc-400 tracking-wider">Foundations</span>
  </div>
  <Typography />
  <Colors />
  <CodeColors />
  <ContainerSpacing />
  <Shapes />
  <Animations />
  <div class="mt-20 mb-2">
    <span class="uppercase text-xs font-heading font-semibold text-zinc-400 tracking-wider">Components</span>
  </div>
  <ContextualBlocks />
  <Hero />
  <Card />
  <Buttons />
  <FormsInputs />
  <LoadingSkeletons />
  <Callout />
  <div class="mt-20 mb-2">
    <span class="uppercase text-xs font-heading font-semibold text-zinc-400 tracking-wider">Guidelines</span>
  </div>
  <States />
  <DosAndDonts />
</Layout>
