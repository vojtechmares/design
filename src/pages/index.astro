---
import Layout from '../layouts/Layout.astro';
import { ArrowRight, Paintbrush, FileText, Image, Layers } from '@lucide/astro';

const designs = [
  {
    title: 'Design System',
    description: 'Complete visual style specification. The single source of truth for design and web development.',
    href: '/design-system',
    icon: 'Paintbrush',
    done: true,
  },
  {
    title: 'Simplified Design System',
    description: 'A condensed version of the design system for quick reference and handoff.',
    icon: 'Layers',
    done: false,
  },
  {
    title: 'Printables',
    description: 'Print-ready assets, cheat sheets, and reference cards.',
    icon: 'FileText',
    done: false,
  },
  {
    title: 'Pictures',
    description: 'Promotional photos from workshops, talks, and events.',
    icon: 'Image',
    done: false,
  },
];

const iconMap: Record<string, any> = { Paintbrush, Layers, FileText, Image };
---

<Layout title="Mares Design">
  <section class="pb-10">
    <h1>Mares Design</h1>
    <p class="mt-2 text-base text-zinc-500">Design resources, assets, and visual specifications.</p>
  </section>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    {designs.map((item) => {
      const Icon = iconMap[item.icon];
      return item.done ? (
        <a href={item.href} class="group block bg-white inset-shadow-sm inset-shadow-zinc-900/10 overflow-hidden p-6 no-underline transition-all hover:inset-shadow-orange-500/20 hover:bg-orange-50/50">
          <div class="flex items-start gap-4">
            <div class="shrink-0 mt-0.5 text-orange-500">
              <Icon size={24} />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-lg font-semibold text-zinc-900 group-hover:text-orange-600 transition-colors">{item.title}</h3>
              <p class="mt-1 text-sm text-zinc-500">{item.description}</p>
            </div>
          </div>
          <div class="flex justify-end mt-4">
            <span class="inline-flex items-center gap-1.5 text-sm font-mono font-medium text-orange-600 group-hover:gap-2.5 transition-all">
              View <ArrowRight size={14} />
            </span>
          </div>
        </a>
      ) : (
        <div class="bg-zinc-50 inset-shadow-sm inset-shadow-zinc-900/5 overflow-hidden p-6 opacity-60">
          <div class="flex items-start gap-4">
            <div class="shrink-0 mt-0.5 text-zinc-400">
              <Icon size={24} />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-lg font-semibold text-zinc-400">{item.title}</h3>
              <p class="mt-1 text-sm text-zinc-400">{item.description}</p>
            </div>
          </div>
          <div class="flex justify-end mt-4">
            <span class="inline-flex items-center gap-1.5 text-xs font-mono font-medium text-zinc-400 uppercase tracking-wider">Coming soon</span>
          </div>
        </div>
      );
    })}
  </div>
</Layout>
