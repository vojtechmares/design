---
import Layout from '../layouts/Layout.astro';
import { ArrowRight, Paintbrush, FileText, Image, Layers } from '@lucide/astro';

const designs = [
  {
    title: 'Design System',
    description: 'Complete visual style specification. The single source of truth for design and web development.',
    href: '/design-system',
    icon: 'Paintbrush',
    done: true,
  },
  {
    title: 'Simplified Design System',
    description: 'A condensed version of the design system for quick reference and handoff.',
    href: '/simplified-design-system',
    icon: 'Layers',
    done: true,
    dark: true,
  },
  {
    title: 'Printables',
    description: 'Print-ready assets, cheat sheets, and reference cards.',
    href: '/printables',
    icon: 'FileText',
    done: true,
  },
  {
    title: 'Pictures',
    description: 'Promotional photos from workshops, talks, and events.',
    icon: 'Image',
    done: false,
  },
];

const iconMap: Record<string, any> = { Paintbrush, Layers, FileText, Image };
---

<Layout title="Mares Design">
  <section class="pb-10">
    <h1>Mares Design</h1>
    <p class="mt-2 text-base text-neutral-500">Design resources, assets, and visual specifications.</p>
  </section>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    {designs.map((item) => {
      const Icon = iconMap[item.icon];
      return item.done ? (
        <div class:list={["group overflow-hidden p-6 transition-all duration-300 ease hover:-translate-y-0.5", item.dark ? "bg-neutral-900" : "bg-orange-50"]}>
          <div class="flex items-start gap-4">
            <div class="shrink-0 mt-0.5 text-orange-500">
              <Icon size={24} />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class:list={["text-lg font-semibold", item.dark ? "text-neutral-100" : "text-neutral-900"]}>{item.title}</h3>
              <p class:list={["mt-1 text-sm", item.dark ? "text-neutral-400" : "text-neutral-600"]}>{item.description}</p>
            </div>
          </div>
          <div class="flex justify-end mt-4">
            <a href={item.href} class:list={["inline-flex items-center gap-1.5 text-sm font-mono font-medium underline group-hover:gap-2.5 transition-all", item.dark ? "text-orange-400" : "text-orange-600"]}>
              View <ArrowRight size={14} />
            </a>
          </div>
        </div>
      ) : (
        <div class="bg-orange-50 overflow-hidden p-6 opacity-50">
          <div class="flex items-start gap-4">
            <div class="shrink-0 mt-0.5 text-neutral-400">
              <Icon size={24} />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-lg font-semibold text-neutral-400">{item.title}</h3>
              <p class="mt-1 text-sm text-neutral-400">{item.description}</p>
            </div>
          </div>
          <div class="flex justify-end mt-4">
            <span class="inline-flex items-center gap-1.5 text-xs font-mono font-medium text-neutral-400 uppercase tracking-wider">Coming soon</span>
          </div>
        </div>
      );
    })}
  </div>
</Layout>
